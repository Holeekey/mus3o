# Solo el servidor lee este archivo. Nunca uses variables VITE_ para secretos.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3001
# Origen permitido por CORS (frontend)
WEB_ORIGIN=http://localhost:5173
# Tope diario de generaciones con IA (fallos de caché)
MAX_DAILY_GENERATIONS=200
# Solo depuración: habilita POST /api/improve-prompt (con "true"). Déjalo vacío en producción.
ENABLE_DEBUG_ROUTES=
# Voz natural opcional (ElevenLabs). Sin clave se usa la voz del navegador. Solo servidor.
ELEVENLABS_API_KEY=
# Id de voz (10-40 caracteres alfanuméricos). Vacío o inválido: usa la voz por defecto del servidor.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Tope diario de caracteres enviados a ElevenLabs
MAX_DAILY_TTS_CHARS=30000
# Modelos 3D low-poly opcionales (Poly Pizza, CC0/CC-BY). Sin clave los pedestales usan glifos procedurales. Solo servidor.
POLY_PIZZA_API_KEY=
# Carpeta de la caché de .glb (por defecto .cache/assets)
ASSET_CACHE_DIR=
# Carpeta de la caché en disco de museos generados (por defecto .cache/museums)
MUSEUM_CACHE_DIR=
# Modelos baratos/opcionales de las llamadas auxiliares
ANTHROPIC_FALLBACK_MODEL=claude-haiku-5-5
ANTHROPIC_DIORAMA_MODEL=
# Formato del flujo completo: dsl (por defecto, barato) o json (anterior, ~3x más salida)
FLOW_FORMAT=dsl
# Solo si la API key no pertenece a un workspace (error "not scoped to a workspace").
ANTHROPIC_WORKSPACE_ID=
# Modelos de las llamadas auxiliares de Aris y del resumen (por defecto ANTHROPIC_FALLBACK_MODEL / claude-haiku-5-5)
ANTHROPIC_ARIS_MODEL=
ANTHROPIC_DIGEST_MODEL=
# Topes diarios de las funciones con IA (valores por defecto)
MAX_DAILY_ARIS_HELP=150
MAX_DAILY_PHOTO_DIORAMAS=150
# Peticiones por minuto a /api/diorama-from-image (por defecto 20)
PHOTO_DIORAMA_RATE_LIMIT=20
# Retardo en ms al reproducir desde caché el flujo en streaming (por defecto 450)
STREAM_REPLAY_DELAY_MS=450
# Carpetas de caché y semillas (vacío = rutas por defecto del repo)
IMAGE_CACHE_DIR=
IMAGE_SEED_DIR=
DIORAMA_SEED_DIR=
LIBRARY_DIR=
# Si se define, el tope diario se guarda aquí (si no, usa CACHE_DIR)
BUDGET_CACHE_DIR=
CACHE_DIR=
# Tamaño máximo de la caché de imágenes en MB (por defecto 200)
IMAGE_CACHE_MAX_MB=200
# User-Agent enviado a Wikimedia al buscar imágenes (recomendado: nombre + contacto)
WIKIMEDIA_USER_AGENT=
# URL del repo que se cita como fuente en la biblioteca
LIBRARY_SOURCE_URL=https://github.com/platanus-hack/platanus-hack-26-ve-team-5
