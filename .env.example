# Solo el servidor lee este archivo. Nunca uses variables VITE_ para secretos.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3001
# Origen permitido por CORS (frontend)
WEB_ORIGIN=http://localhost:5173
# Tope diario de generaciones con IA (fallos de caché)
MAX_DAILY_GENERATIONS=200
# Solo depuración: habilita POST /api/improve-prompt (con "true"). Déjalo vacío en producción.
ENABLE_DEBUG_ROUTES=
# Voz natural opcional (ElevenLabs). Sin clave se usa la voz del navegador. Solo servidor.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Tope diario de caracteres enviados a ElevenLabs
MAX_DAILY_TTS_CHARS=30000
# Solo si la API key no pertenece a un workspace (error "not scoped to a workspace").
ANTHROPIC_WORKSPACE_ID=
