{
  "name": "mus3o-3d",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @mus3o/server\" \"npm run dev -w @mus3o/web\"",
    "dev:web": "npm run dev -w @mus3o/web",
    "dev:https": "npm run dev:https -w @mus3o/web",
    "dev:tunnel": "npm run dev:tunnel -w @mus3o/web",
    "dev:server": "npm run dev -w @mus3o/server",
    "build": "npm run build -w @mus3o/shared && npm run build -w @mus3o/server && npm run build -w @mus3o/web",
    "start": "node apps/server/dist/index.js",
    "test:dungeon": "npm run test -w @mus3o/dungeon-core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@bufbuild/protobuf": "2.16.0"
    }
  }
}
